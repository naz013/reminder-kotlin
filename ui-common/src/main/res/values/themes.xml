<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Reminder" parent="android:Theme.Material.Light.NoActionBar">
        <!--
            Setting windowBackground to transparent prevents the white window background from
            bleeding through during Compose Navigation transitions (the 1-frame gap before the
            Compose animation initial values are applied). Compose handles all drawing itself.
        -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.Dropbox" parent="Theme.Material3.Light.NoActionBar" />
</resources>
